<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.EditLessonActivity">

    <!-- App Bar Layout -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary">

            <!-- Toolbar תופס את כל הרוחב -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimary"
                android:elevation="0dp"
                android:paddingEnd="70dp"
                app:subtitleTextColor="@color/textGeneral"
                app:titleTextColor="@color/textGeneral" />

            <!-- התמונה מיושרת לצד ימין -->
            <ImageView
                android:id="@+id/toolbarLogo"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:background="@color/colorPrimary"
                android:contentDescription="App Logo"
                android:src="@drawable/rcook_logo1" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Header with Title and Image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/successColor"
            android:padding="10dp"
            android:layout_marginBottom="0dp">

            <!-- Title Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit / Add a lesson"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Create and edit your cooking lessons"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Lesson Image -->
            <ImageView
                android:id="@+id/imageEditLesson"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/edit_add_image"
                android:scaleType="centerCrop"
                android:contentDescription="Edit lesson icon" />

        </LinearLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Lesson Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Lesson Name"
                        android:textAllCaps="false"
                        android:textColor="@color/textGeneral"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <EditText
                        android:id="@+id/lesson_name"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Enter lesson name"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary" />
                </LinearLayout>

                <!-- Guide Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Guide Name"
                        android:textColor="@color/textGeneral"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <EditText
                        android:id="@+id/lesson_guide"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Enter guide name"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary" />
                </LinearLayout>

                <!-- Short Description -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Short Description"
                        android:textColor="@color/textGeneral"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <EditText
                        android:id="@+id/lesson_short_description"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Brief description"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary" />
                </LinearLayout>

                <!-- Full Description -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Full Description"
                        android:textColor="@color/textGeneral"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <EditText
                        android:id="@+id/lesson_full_description"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/edit_text_background"
                        android:gravity="top"
                        android:hint="Detailed description"
                        android:inputType="textMultiLine"
                        android:padding="16dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary" />
                </LinearLayout>

                <!-- Level Spinner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Level"
                        android:textColor="@color/textGeneral"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <Spinner
                        android:id="@+id/lesson_level_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/spinner_background"
                        android:dropDownSelector="@color/colorPrimaryDark"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>

                <!-- Video Upload Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Video"
                        android:textColor="@color/textGeneral"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/lesson_video_url"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/edit_text_background"
                            android:hint="Video file name"
                            android:inputType="text"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textSecondary" />

                        <Button
                            android:id="@+id/select_video_button"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:backgroundTint="@color/colorStatusBar"
                            android:drawablePadding="8dp"
                            android:paddingHorizontal="16dp"
                            android:text="Browse"
                            android:textColor="#204D78" />
                    </LinearLayout>

                    <!-- Video Preview -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/video_preview_card"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="8dp"
                        android:visibility="visible"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <VideoView
                                android:id="@+id/video_preview"
                                android:layout_width="match_parent"
                                android:layout_height="300dp"
                                android:layout_centerInParent="true" />

                            <!-- Default video placeholder -->
                            <LinearLayout
                                android:id="@+id/video_placeholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#E0E0E0"
                                android:gravity="center"
                                android:orientation="vertical">

                                <!-- Use a simple drawable instead of ic_video_placeholder -->
                                <ImageView
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:src="@android:drawable/ic_media_play"
                                    app:tint="#757575" />

                                <TextView
                                    android:id="@+id/video_placeholder_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="No video selected"
                                    android:textColor="#757575"
                                    android:textSize="14sp"
                                    android:textAlignment="center"
                                    android:gravity="center" />

                            </LinearLayout>

                            <!-- Optional: Add a play/pause overlay button -->
                            <ImageView
                                android:id="@+id/video_play_overlay"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_centerInParent="true"
                                android:background="@android:drawable/ic_media_play"
                                android:visibility="gone"
                                android:alpha="0.7"
                                app:tint="#FFFFFF" />

                        </RelativeLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Image Upload Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Image"
                        android:textColor="@color/textGeneral"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/lesson_image_url"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/edit_text_background"
                            android:hint="Image file name"
                            android:inputType="text"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textSecondary" />

                        <Button
                            android:id="@+id/select_image_button"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:backgroundTint="@color/colorStatusBar"
                            android:drawablePadding="8dp"
                            android:paddingHorizontal="16dp"
                            android:text="Browse"
                            android:textColor="#204D78" />
                    </LinearLayout>

                    <!-- Image Preview -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/image_preview_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="visible"
                        app:cardCornerRadius="75dp"
                        app:cardElevation="4dp">

                        <ImageView
                            android:id="@+id/image_preview"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/errorColor"
                android:text="Cancel"
                android:textColor="@color/colorRed"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/colorAccent"
                android:text="Save Lesson"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>